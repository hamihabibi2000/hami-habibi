rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny all access
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to read and write to their own 'user_photos' folder.
    // Users can upload photos to their own designated path.
    // Public read access to photos is generally not recommended unless specificallly intended.
    // For this example, we allow read if authenticated, but this could be further restricted.
    match /user_photos/{userId}/{fileName} {
      allow read: if request.auth != null; // Or true if photos are public, or check against a list of friends/matches
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Placeholder for other potential storage paths (e.g., chat media)
    // match /chat_media/{chatId}/{mediaFile} {
    //   allow read, write: if request.auth != null && /* user is part of this chat */;
    // }
  }
}
