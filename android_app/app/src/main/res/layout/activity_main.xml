<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryBackgroundBlack">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_navigation_view"
        app:defaultNavHost="true"
                app:navGraph="@navigation/app_nav_graph" />

    <!-- Conceptual button to launch EditProfileActivity from MainActivity -->
    <!-- In a real app, this would be in a ProfileFragment -->
    <Button
        android:id="@+id/buttonGoToEditProfile_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Profile (Temp)"
        android:layout_centerInParent="true"
        android:backgroundTint="@color/highlightPurple"
        android:textColor="@color/primaryTextWhite"
        android:visibility="gone"/> <!-- Initially hidden, shown by MainActivity if needed for testing -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_view"
        style="@style/Widget.CatchMeNearby.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/bottom_nav_menu" />
</RelativeLayout>
