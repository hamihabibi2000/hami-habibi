<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryBackgroundBlack"
    tools:context=".features.profile.ui.EditProfileActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/secondaryBackgroundDarkGray"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_edit_profile"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Edit Profile"
            app:titleTextColor="@color/primaryTextWhite"
            app:navigationIcon="@drawable/ic_arrow_back_white_24dp" /> <!-- Placeholder, add actual icon -->
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/progressBar_editProfile_loading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="visible"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutUsername_edit"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username"
                app:hintTextColor="@color/secondaryTextCyan"
                app:boxStrokeColor="@color/primaryAccentPurple">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextUsername_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/primaryTextWhite" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutBio_edit"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Bio"
                app:hintTextColor="@color/secondaryTextCyan"
                app:boxStrokeColor="@color/primaryAccentPurple">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextBio_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top"
                    android:textColor="@color/primaryTextWhite" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile Photos (Max 7)"
                android:textColor="@color/secondaryTextCyan"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:textSize="16sp"/>

            <!-- RecyclerView would be better here -->
            <LinearLayout
                android:id="@+id/linearLayoutPhotos_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Photos will be added here dynamically -->
            </LinearLayout>

            <Button
                android:id="@+id/buttonAddPhoto_edit"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add Photo (Placeholder)"
                android:textColor="@color/primaryAccentPurple"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLocationSharing_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Enable Location Sharing"
                android:textColor="@color/primaryTextWhite"
                app:thumbTint="@color/primaryAccentPurple"
                app:trackTint="@color/secondaryTextCyan" />

            <Button
                android:id="@+id/buttonSaveProfile_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/primaryAccentPurple"
                android:text="Save Profile"
                android:textColor="@color/primaryTextWhite"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"/>

            <ProgressBar
                android:id="@+id/progressBar_editProfile_saving"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                tools:visibility="visible"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
